function plot_signal_comparison(raw_data, filtered_data, subject_id,is_overlay, Chan_lab,eeg_preprc_stage, time_segment, fontSize)
    % Plots a segment of raw (upper panel) vs. filtered signal (lower panel) for a single channel
    % Input: raw_data, filtered_data (FieldTrip structures), subject_id (string),
    %        time_segment (samples), fontSize (optional, default=12)
    % eeg_preprc_stage- {'raw','after filters'}, is_overlay- 1 for yes
    % (both traces should be overlayed on each other) and 0 for no.
    % Usage: plot_signal_comparison(EEG_raw, EEG_clean, '011201', [], 14)

    % Set default values if not provided
    if nargin < 8
        fontSize = 12;
    end
    if nargin < 7
        time_segment = [1, min(5000, size(raw_data.trial{1}, 2))]; % First 5000 samples or less
    end
    if nargin <5
        Chan_lab='Cz';
    end
    if nargin<6
        eeg_preprc_stage={'Raw','After Preprocessing: Detrend, Bandpass Filter, Notch, Artefact Removal & ICA '};
    end


    chan_idx = find(strcmp(raw_data.label, Chan_lab));
    if isempty(chan_idx)
        chan_idx = 1;
    end

    
    time_axis = raw_data.time{1}(time_segment(1):time_segment(2));
    figure('Position', [100 100 1200 500]);

    if is_overlay
        plot(time_axis, raw_data.trial{1}(chan_idx, time_segment(1):time_segment(2)), 'k', 'LineWidth', 0.5);
        hold on;
        plot(time_axis, filtered_data.trial{1}(chan_idx, time_segment(1):time_segment(2)), 'b', 'LineWidth', 0.5);
        title(sprintf('Channel %s - Subject %s',raw_data.label{chan_idx}, subject_id));
        legend(eeg_preprc_stage);
        ylabel('Amplitude (µV)', 'FontSize', fontSize);
        set(gca, 'FontSize', fontSize);
        grid on;
    else
        % Raw signal
        subplot(2, 1, 1);
        plot(time_axis, raw_data.trial{1}(chan_idx, time_segment(1):time_segment(2)), 'k', 'LineWidth', 0.5);
        title(sprintf('%s EEG - Channel %s - Subject %s', eeg_preprc_stage{1}, raw_data.label{chan_idx}, subject_id), 'FontSize', fontSize);
        ylabel('Amplitude (µV)', 'FontSize', fontSize);
        set(gca, 'FontSize', fontSize);
        grid on;
    
        % Filtered signal
        subplot(2, 1, 2);
        plot(time_axis, filtered_data.trial{1}(chan_idx, time_segment(1):time_segment(2)), 'b', 'LineWidth', 0.5);
        title(eeg_preprc_stage{2}, 'FontSize', fontSize);
        xlabel('Time (s)', 'FontSize', fontSize);
        ylabel('Amplitude (µV)', 'FontSize', fontSize);
        set(gca, 'FontSize', fontSize);
        grid on;
    end

end