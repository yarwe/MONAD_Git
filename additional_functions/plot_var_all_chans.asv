function [var_chans, out_nums, out_labels, max_win_info] = plot_var_all_chans(ID, EEG, nEEGchans, varargin)
% Plots variance per EEG channel with interactive labels and outlier marking.
%
% Required inputs:
%   ID        - subject identifier (used in figure title)
%   EEG       - FieldTrip structure with fields: label, trial, fsample
%   nEEGchans - number of EEG channels to include
%
% Optional name-value pairs:
%   'window_sec'       - window length in seconds. The recording is divided into
%                        non-overlapping windows of this length; variance is
%                        computed per window and the mean across windows is
%                        plotted. Default: 2 s. Set to 0 or [] for regular
%                        (whole-recording) variance instead.
%   'fs'               - sampling frequency in Hz. Defaults to EEG.fsample.
%
%   'show_max_window'  - (windowed mode only) whether clicking a channel in the
%                        variance plot opens a second figure showing that
%                        channel's top-variance time segment(s), with all other
%                        channels in the background. true (default) | false
%
%   'n_top_wins'       - (windowed mode only) number of top-variance windows to
%                        store and display per channel. Default: 1 (just the max).
%                        E.g. set to 5 to capture the 5 highest-variance epochs.
%
%   'outlier_methods'  - 'none' | one method | cell array of methods
%                        Methods: 'zscore', 'iqr', 'mad'. Default: 'zscore'
%                        'none'     : plot only, no outlier marking
%                        Single     : mark all outliers in one color
%                        Multiple   : mark per-method and intersection separately
%
%   'outlier_thresh'   - scalar or struct with per-method thresholds.
%                        Struct: e.g. struct('zscore',2.5,'iqr',1.5,'mad',2.5)
%                        Defaults per method: zscore=2.5, iqr=1.5, mad=2.5
%
% Outputs:
%   var_chans    - nEEGchans x 1 vector of (mean) variance per channel
%   max_win_info - (windowed mode only) MATLAB table with one row per
%                  (channel, rank) pair and columns:
%                    Channel   : channel label (string)
%                    Rank      : 1 = highest variance, 2 = second highest, …
%                    WinIdx    : window index within the recording
%                    SampStart : first sample of the window
%                    SampEnd   : last  sample of the window
%                    TimeStart : start time in seconds
%                    TimeEnd   : end   time in seconds
%                  Empty struct if windowed mode is off.
%
% Examples:
%   % Default: 2 s windows, z-score outliers
%   plot_var_all_chans(ID, EEG, 64)
%
%   % Click any channel in the variance plot to see its max-variance segment
%   plot_var_all_chans(ID, EEG, 64, 'show_max_window', true)
%
%   % Multi-method outliers, no time-segment plot
%   plot_var_all_chans(ID, EEG, 64, 'outlier_methods', {'zscore','iqr'})
%
%   % Plain whole-recording variance
%   plot_var_all_chans(ID, EEG, 64, 'window_sec', 0)
%
%   % Show the 5 highest-variance epochs when clicking a channel
%   plot_var_all_chans(ID, EEG, 64, 'n_top_wins', 5)

p = inputParser;
addParameter(p, 'window_sec',      2);
addParameter(p, 'fs',              []);
addParameter(p, 'show_max_window', true);
addParameter(p, 'n_top_wins',      1);
addParameter(p, 'outlier_methods', 'zscore');
addParameter(p, 'outlier_thresh',  []);
parse(p, varargin{:});

window_sec      = p.Results.window_sec;
fs              = p.Results.fs;
show_max_window = p.Results.show_max_window;  % logical
n_top_wins      = p.Results.n_top_wins;
methods_in      = p.Results.outlier_methods;
thresh_in       = p.Results.outlier_thresh;

% Resolve sampling frequency
if isempty(fs)
    fs = EEG.fsample;
end

% Normalise methods to cell array (or empty for 'none')
if ischar(methods_in) || isstring(methods_in)
    methods_in = char(methods_in);
    if strcmpi(methods_in, 'none')
        methods = {};
    else
        methods = {methods_in};
    end
else
    methods = methods_in;
end
valid_methods = {'zscore','iqr','mad'};
for m = 1:numel(methods)
    assert(ismember(methods{m}, valid_methods), ...
        'Unknown method "%s". Choose from: zscore, iqr, mad.', methods{m});
end

default_thresh = struct('zscore', 3, 'iqr', 1.5, 'mad', 2.5);

%% Compute variance (regular or windowed)
all_chans_index = 1:nEEGchans;
data = EEG.trial{1}(all_chans_index, :);   % chan x time

use_sliding = ~isempty(window_sec) && window_sec > 0;
max_win_info = struct();
 label_col = EEG.label(all_chans_index)';
label_col = label_col(:);

if ~use_sliding
    var_chans      = var(data, 0, 2,"omitnan");
    var_mode_label = 'variance';
else
    win_samps = round(window_sec * fs);
    nTime     = size(data, 2);
    nWins     = floor(nTime / win_samps);
    assert(nWins >= 1, 'window_sec (%.1f s) is longer than the recording.', window_sec);

    data_trimmed = data(:, 1 : nWins * win_samps);
    data_3d      = reshape(data_trimmed, nEEGchans, win_samps, nWins);  % chan x samp x win
    win_vars     = squeeze(var(data_3d, 0, 2,"omitnan"));   % chan x nWins
    var_chans    = mean(win_vars, 2);
    var_mode_label = sprintf('mean variance (%.1fs windows, n=%d)', window_sec, nWins);

    % Per-channel top-N-variance windows (sorted descending by variance)
    n_top_wins = min(n_top_wins, nWins);
    [~, sorted_idx] = sort(win_vars, 2, 'descend');   % nEEGchans x nWins
    top_win_idx   = sorted_idx(:, 1:n_top_wins);       % nEEGchans x n_top_wins
    sample_starts = (top_win_idx - 1) * win_samps + 1;
    sample_ends   = sample_starts + win_samps - 1;
    time_starts = (sample_starts - 1) / fs;
    time_ends   = sample_ends / fs;

    % Build flat table: one row per (channel, rank) pair
   
    channels  = repelem(label_col, n_top_wins);
    ranks     = repmat((1:n_top_wins)', nEEGchans, 1);
    % Flatten row-major (each channel's ranks together) to match channels/ranks order
    flat = @(M) reshape(M', [], 1);
    max_win_info = table(channels, ranks, ...
        flat(top_win_idx), flat(sample_starts), flat(sample_ends), ...
        flat(time_starts), flat(time_ends), ...
        'VariableNames', {'Channel','Rank','WinIdx','SampStart','SampEnd','TimeStart','TimeEnd'});

    % % Print table to console (one row per channel per top window)
    % fprintf('\nTop-%d variance window(s) per channel (Subject %s):\n', n_top_wins, num2str(ID));
    % fprintf('%-12s  %4s  %6s  %8s  %8s  %8s  %8s\n', ...
    %     'Channel','Rank','Win #','Samp start','Samp end','T start (s)','T end (s)');
    % fprintf('%s\n', repmat('-', 1, 70));
    % for ch = 1:nEEGchans
    %     for k = 1:n_top_wins
    %         fprintf('%-12s  %4d  %6d  %10d  %8d  %11.3f  %8.3f\n', ...
    %             EEG.label{ch}, k, top_win_idx(ch, k), ...
    %             sample_starts(ch, k), sample_ends(ch, k), ...
    %             time_starts(ch, k), time_ends(ch, k));
    %     end
    % end
    % fprintf('\n');
end

%% Detect outliers
n = numel(methods);
is_out_mat  = false(nEEGchans, n);
thresh_used = struct();

for m = 1:n
    mth = methods{m};
    if isstruct(thresh_in) && isfield(thresh_in, mth)
        thr = thresh_in.(mth);
    elseif isscalar(thresh_in) && ~isempty(thresh_in)
        thr = thresh_in;
    else
        thr = default_thresh.(mth);
    end
    thresh_used.(mth) = thr;

    switch mth
        case 'zscore'
            scores = (var_chans - mean(var_chans)) / std(var_chans);
            is_out_mat(:, m) = abs(scores) > thr;
        case 'iqr'
            q1 = quantile(var_chans, 0.25);
            q3 = quantile(var_chans, 0.75);
            fence = thr * (q3 - q1);
            is_out_mat(:, m) = var_chans < (q1 - fence) | var_chans > (q3 + fence);
        case 'mad'
            med     = median(var_chans);
            mad_val = median(abs(var_chans - med));
            scores  = (var_chans - med) / (1.4826 * mad_val);
            is_out_mat(:, m) = abs(scores) > thr;
    end
end

out_nums=find(is_out_mat);
out_labels=label_col(out_nums);

method_labels = cell(1, n);
for m = 1:n
    mth = methods{m};
    thr = thresh_used.(mth);
    switch mth
        case 'zscore', method_labels{m} = sprintf('Z>%.1f', thr);
        case 'iqr',    method_labels{m} = sprintf('IQR*%.1f', thr);
        case 'mad',    method_labels{m} = sprintf('MAD>%.1f', thr);
    end
end

combo_styles = define_combo_styles(n);

%% Figure 1: variance per channel
fig = figure;
plot(var_chans, 'k', 'LineWidth', 1.2);
hold on;

legend_handles = [];

if n == 0
    % no outlier marking

elseif n == 1
    is_out = is_out_mat(:, 1);
    if any(is_out)
        h = mark_group(find(is_out), var_chans, EEG.label, ...
            combo_styles(1).color, combo_styles(1).marker, method_labels{1});
        legend_handles(end+1) = h;
    end

else
    combos     = generate_combos(n);
    used_style = 1;
    for c = 1:size(combos, 1)
        mask       = combos(c, :);
        in_these   = all(is_out_mat(:,  logical(mask)), 2);
        not_others = all(~is_out_mat(:, ~logical(mask)), 2);
        members    = find(in_these & not_others);
        if isempty(members), continue; end

        lbl = strjoin(method_labels(logical(mask)), ' & ');
        sty = combo_styles(used_style);
        h   = mark_group(members, var_chans, EEG.label, sty.color, sty.marker, lbl);
        legend_handles(end+1) = h;
        used_style = used_style + 1;
    end
end

if ~isempty(legend_handles)
    legend(legend_handles, 'Location', 'northeast');
end

set(gca, 'FontSize', 12, ...
    'XTick',              all_chans_index, ...
    'XTickLabel',         EEG.label(all_chans_index), ...
    'XTickLabelRotation', 90);
ylabel('Channel variance (\muV^2)');
title(sprintf('Subject %s — %s', num2str(ID), var_mode_label));
xlim([0.5, nEEGchans + 0.5]);

% Use WindowButtonDownFcn for reliable channel selection regardless of y-value.
% datacursormode snaps by screen distance and misses high-variance outliers.
if use_sliding && show_max_window
    ax_h = gca;
    ax_h.Title.String = [ax_h.Title.String ' — click a channel for its top-variance segment(s)'];
    set(fig, 'WindowButtonDownFcn', @(~,~) fig1_click(fig, data, EEG.label, fs, ...
        nEEGchans, nWins, top_win_idx, sample_starts, sample_ends, time_starts, time_ends, ...
        ID, all_chans_index, var_chans, n_top_wins));
else
    % No segment plot needed — just show channel name in title on hover
    set(fig, 'WindowButtonMotionFcn', @(~,~) fig1_hover(fig, EEG.label, all_chans_index));
end

end

%% ---- Click callback: identify channel by x position, open segment figure -
function fig1_click(fig1, data, labels, fs, nEEGchans, nWins, top_win_idx, sample_starts, sample_ends, time_starts, time_ends, ID, chan_idx, var_chans, n_top_wins)
ax = findobj(fig1, 'Type', 'axes');
if isempty(ax), return; end
pt = get(ax(1), 'CurrentPoint');
xi = round(pt(1, 1));
if xi < 1 || xi > numel(chan_idx), return; end
ch_idx = chan_idx(xi);

% Show tooltip annotation (delete any previous one first)
delete(findobj(fig1, 'Tag', 'chan_tip'));
axes(ax(1));
text(xi, var_chans(ch_idx), ...
    sprintf('  %s\n  %.1f \\muV^2', labels{ch_idx}, var_chans(ch_idx)), ...
    'FontSize', 9, 'BackgroundColor', 'white', 'EdgeColor', [0.5 0.5 0.5], ...
    'VerticalAlignment', 'bottom', 'Tag', 'chan_tip');

% Colour ramp for top-N windows: rank 1 = red, fading to orange/yellow
top_colors = zeros(n_top_wins, 3);
for k = 1:n_top_wins
    t = (k - 1) / max(n_top_wins - 1, 1);   % 0 (rank 1) → 1 (rank N)
    top_colors(k, :) = [1, 0.3 + 0.5*t, 0.1*t];   % red → warm yellow
end

figure;
hold on;

win_len = sample_ends(ch_idx, 1) - sample_starts(ch_idx, 1) + 1;

for k = 1:n_top_wins
    s1   = sample_starts(ch_idx, k);
    s2   = sample_ends(ch_idx, k);
    t_ax = (0 : win_len - 1) / fs;   % relative time axis same for all windows
    seg  = data(:, s1:s2);
    seg  = detrend(seg')';

    % Grey background channels only on the first window to avoid clutter
    if k == 1
        for ch = 1:nEEGchans
            if ch == ch_idx, continue; end
            plot(t_ax, seg(ch, :), 'Color', [0.75 0.75 0.75], 'LineWidth', 0.5, ...
                'HandleVisibility', 'off');
        end
    end

    clr = top_colors(k, :);
    lbl = sprintf('%s — rank %d (win %d, %.3f–%.3f s)', ...
        labels{ch_idx}, k, top_win_idx(ch_idx, k), ...
        time_starts(ch_idx, k), time_ends(ch_idx, k));
    plot(t_ax, seg(ch_idx, :), 'Color', clr, 'LineWidth', 2, 'DisplayName', lbl);
end

xlabel('Time within window (s)');
ylabel('Amplitude (\muV)');
title(sprintf('Subject %s — top-%d variance windows for %s (/%d total)', ...
    num2str(ID), n_top_wins, labels{ch_idx}, nWins));
legend('Location', 'northeast');
set(gca, 'FontSize', 12);

figure(fig1);   % restore focus so next click works immediately
end

%% ---- Helper: plot one group of outlier channels --------------------------
function h = mark_group(idx, var_chans, labels, clr, mkr, lbl)
h = plot(idx, var_chans(idx), mkr, ...
    'Color', clr, 'MarkerFaceColor', clr, ...
    'MarkerSize', 9, 'DisplayName', lbl);
for k = 1:numel(idx)
    text(idx(k), var_chans(idx(k)), ['  ' labels{idx(k)}], ...
        'Color', clr, 'FontSize', 9, 'Rotation', 45);
end
end

%% ---- Helper: enumerate all non-empty subsets, intersection-first ----------
function combos = generate_combos(n)
all_combos = [];
for popcount = n:-1:1
    idx = nchoosek(1:n, popcount);
    for r = 1:size(idx, 1)
        row = false(1, n);
        row(idx(r, :)) = true;
        all_combos(end+1, :) = row;
    end
end
combos = all_combos;
end

%% ---- Helper: visual styles per combo slot --------------------------------
function styles = define_combo_styles(n)
palette = {
    [0.85 0.10 0.10], 'o';
    [0.93 0.53 0.00], 's';
    [0.00 0.45 0.74], 'd';
    [0.13 0.63 0.30], '^';
    [0.56 0.12 0.71], 'v';
    [0.64 0.08 0.18], 'p';
    [0.30 0.75 0.93], 'h';
};
total = max(2^n - 1, 1);
styles = struct('color', cell(1, total), 'marker', cell(1, total));
for i = 1:total
    row = min(i, size(palette, 1));
    styles(i).color  = palette{row, 1};
    styles(i).marker = palette{row, 2};
end
end

%% ---- Hover callback: show channel name in figure title (non-sliding mode) -
function fig1_hover(fig1, labels, chan_idx)
ax = findobj(fig1, 'Type', 'axes');
if isempty(ax), return; end
pt = get(ax(1), 'CurrentPoint');
xi = round(pt(1, 1));
if xi >= 1 && xi <= numel(chan_idx)
    set(get(ax(1), 'Title'), 'String', ...
        sprintf('Hovering: %s', labels{chan_idx(xi)}));
end
end
