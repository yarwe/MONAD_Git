function [outputArg1,outputArg2] = untitled(env, filename)
%UNTITLED Summary of this function goes here
%   Detailed explanation goes here
addpath('C:\Users\yoelgo\Documents\eeglab2024.2\');
eeglab;
if strmp(exp, 'OSF_simple')
    EEG          = pop_biosig(filename);
    % Create an empty FieldTrip struct
    data_ft = [];
    
    % Assign EEG data fields
    data_ft.label = {EEG.chanlocs.labels};       % Channel labels
    data_ft.fsample = EEG.srate;                 % Sampling rate
    data_ft.trial = {double(EEG.data)};          % EEG data (convert to double)
    data_ft.time = {EEG.times / 1000};           % Convert time from ms to seconds
    data_ft.hdr = EEG;                           % Add header information if needed

    cfg =[];
    pD = ft_preprocessing([],data_ft)


end
end
